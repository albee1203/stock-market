# 資料庫（預設 SQLite；換成 PostgreSQL 只需改這行，例如 postgresql+psycopg://user:pw@localhost/twstock）
DATABASE_URL=sqlite:///data/twstock.db
# 選用：設定後新聞情緒改用 Claude 分析，未設定則使用內建關鍵字詞典
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# FastAPI 位址（Streamlit 前端使用）
API_BASE_URL=http://127.0.0.1:8000

# ---- 推播（擇一或多個；GitHub Actions 請改設在 repo 的 Secrets）----
# LINE 官方帳號 Messaging API 的 Channel access token；LINE_TO 留空＝廣播給所有好友
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
# Telegram：向 @BotFather 建立 bot 取得 token；chat id 可透過 @userinfobot 取得
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy：手機安裝 ntfy App 並訂閱同名主題（請取難猜的名字，例如 twstock-8f3k2q）
NTFY_TOPIC=
# 推播訊息中附上的 App 網址
APP_URL=

# 我的持股（選用，推播時檢查停損停利）。每行「代號,成本[,停損%,停利%]」，多筆可用分號隔開，例如：
# HOLDINGS=2330,980;2317,190,8,20
HOLDINGS=
